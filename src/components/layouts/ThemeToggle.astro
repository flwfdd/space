---
import { Icon } from "astro-icon/components";
---

<div class="theme-toggle">
  <button
    id="theme-toggle"
    class="btn btn-ghost btn-icon size-10"
    aria-label="切换主题"
  >
    <Icon
      name="mdi:white-balance-sunny"
      class="w-5 h-5 theme-icon hidden hover:rotate-90 transition-all duration-200"
      id="theme-icon-light"
    />
    <Icon
      name="mdi:moon-and-stars"
      class="w-5 h-5 theme-icon hidden hover:-rotate-30 transition-all duration-200"
      id="theme-icon-dark"
    />
    <Icon
      name="mdi:brightness-auto"
      class="w-5 h-5 theme-icon hover:scale-110 transition-all duration-200"
      id="theme-icon-system"
    />
  </button>
</div>

<script is:inline>
  (() => {
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
    const getTheme = () => localStorage.getItem("theme") || "system";

    function applyTheme(theme) {
      const isDark =
        theme === "dark" || (theme === "system" && systemTheme.matches);
      document.documentElement.classList.toggle("dark", isDark);

      for (const name of ["light", "dark", "system"]) {
        document
          .getElementById(`theme-icon-${name}`)
          ?.classList.toggle("hidden", name !== theme);
      }
    }

    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const nextTheme = {
        system: "light",
        light: "dark",
        dark: "system",
      }[getTheme()];
      localStorage.setItem("theme", nextTheme);
      applyTheme(nextTheme);
    });

    systemTheme.addEventListener("change", () => {
      if (getTheme() === "system") applyTheme("system");
    });

    applyTheme(getTheme());
  })();
</script>
