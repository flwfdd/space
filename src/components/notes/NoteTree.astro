---
import { Icon } from "astro-icon/components";
import {
  sortedNoteNodes,
  type NoteTree as NoteTreeData,
} from "@/lib/note-tree";
import NoteTree from "./NoteTree.astro";

export interface Props {
  tree: NoteTreeData;
  currentPath?: string;
  pathPrefix?: string;
}

const { tree, currentPath, pathPrefix = "" } = Astro.props;
---

<ul class={pathPrefix ? "ml-2 border-l border-gray-200 dark:border-gray-700 pl-2" : undefined}>
  {
    sortedNoteNodes(tree).map((node) => {
      const nodePath = pathPrefix ? `${pathPrefix}/${node.name}` : node.name;

      if (node.type === "file") {
        const isActive = currentPath === node.note.id;
        return (
          <li>
            <a
              href={`/notes/${node.note.id}`}
              title={node.title}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "flex items-center rounded-lg p-2 text-sm font-medium transition-colors duration-100 hover:bg-[var(--color-list-hover)]",
                isActive && "text-cyan-500 dark:text-cyan-400",
              ]}
            >
              <span class="truncate">{node.title}</span>
            </a>
          </li>
        );
      }

      const containsCurrent = currentPath?.startsWith(`${nodePath}/`) ?? false;
      return (
        <li>
          <details open={containsCurrent}>
            <summary
              class="flex cursor-pointer list-none items-center space-x-1 truncate rounded-md p-2 transition-colors duration-100 hover:bg-[var(--color-list-hover)] [&::-webkit-details-marker]:hidden"
              title={node.name}
            >
              <Icon
                name="mdi:chevron-right"
                class="folder-arrow size-4 flex-shrink-0 text-gray-400 transition-transform duration-200"
              />
              <span class="text-sm font-bold">{node.name}</span>
            </summary>
            <NoteTree
              tree={node.children}
              currentPath={currentPath}
              pathPrefix={nodePath}
            />
          </details>
        </li>
      );
    })
  }
</ul>

<style>
  details[open] > summary .folder-arrow {
    transform: rotate(90deg);
  }
</style>
