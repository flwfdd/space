---
import Layout from "./Layout.astro";
import Drawer from "@/components/layouts/Drawer.astro";
import NotesIndex from "@/components/notes/NotesIndex.astro";
import TableOfContents from "@/components/notes/TableOfContents.astro";
import { Icon } from "astro-icon/components";

const {
  title = "笔记 - flwfdd's space",
  description = "数字花园",
  headings = [],
  showSidebar = true,
  showToc = true,
  currentPath,
} = Astro.props;
---

<Layout title={title} description={description}>
  <div class="flex max-w-screen-xl mx-auto">
    {
      showSidebar && (
        <div class="hidden lg:block flex-shrink-0 w-48">
          <NotesIndex currentPath={currentPath} />
        </div>
      )
    }

    <div class="flex-1 flex flex-col min-w-0">
      <div class="flex-1">
        <article class="max-w-3xl mx-auto">
          <div class="p-2 sm:p-4">
            <slot />
          </div>
        </article>
      </div>
    </div>

    {
      showToc && (
        <div class="hidden xl:block flex-shrink-0 w-48">
          <TableOfContents headings={headings} />
        </div>
      )
    }

    {
      showSidebar && (
        <Drawer
          id="mobile-sidebar"
          label="笔记目录"
          triggerLabel="打开笔记目录"
          side="left"
          showHeader={false}
          class="lg:hidden"
          triggerClass="btn btn-icon fixed bottom-6 left-6 z-30 size-12 backdrop-blur-sm"
        >
          <Icon slot="trigger" name="mdi:file-tree" class="size-6" />
          <NotesIndex currentPath={currentPath} />
        </Drawer>
      )
    }

    {
      showToc && headings.length > 0 && (
        <Drawer
          id="mobile-toc"
          label="大纲"
          triggerLabel="打开大纲"
          side="right"
          showHeader={false}
          class="xl:hidden"
          triggerClass="btn btn-icon fixed bottom-6 right-6 z-30 size-12 backdrop-blur-sm"
        >
          <Icon slot="trigger" name="mdi:table-of-contents" class="size-6" />
          <TableOfContents headings={headings} />
        </Drawer>
      )
    }
  </div>
</Layout>
