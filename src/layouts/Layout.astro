---
import Footer from "@/components/layouts/Footer.astro";
import Header from "@/components/layouts/Header.astro";
import "@/styles/global.css";
import "katex/dist/katex.min.css";

const {
  title = "flwfdd'space",
  description = "一个记录思考和分享知识的个人空间",
  immersive = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "system";
        const isDark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/saturn.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&display=swap" />
    <title>{title}</title>
  </head>
  <body
    class:list={["min-h-screen flex flex-col bg-gray-100 dark:bg-[#00161C] font-serif text-cyan-900 dark:text-cyan-50 transition-colors duration-200", { "layout-immersive": immersive }]}
  >
    <Header />
    <main class:list={["flex-1 w-full", !immersive && "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"]}>
      <slot />
    </main>
    {!immersive && <Footer />}
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
  }
</style>
